   var dir = pathToImage.split('/');
   var imgFile = dir.pop();
   var splitedImgFile = imgFile.split('.');
   splitedImgFile.pop();
   var srcFile = splitedImgFile.join('.') + '.src';
   var path;
   if (dir.length > 1) {
	  path = dir.join('/') + '/';
   }
   else {
      path = 'http://www.unidev.com.br/';
   }
   try {
      window.sidebar.addSearchEngine(path + srcFile, path + imgFile, promptName, 'Campo de pesquisa do Firefox');
   }
   catch(ex) {
      window.alert('Esta pesquisa é um recurso para usuários do browser Firefox.\r\nInstale-o gratuitamente em http://br.mozdev.org');
   }
}
</script>